{{ 'custom-gallery-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000
-%}

{%- if section.settings.tone == 'custom' -%}
  {%- style -%}
    /* ---------- Custom colour combination ---------- */
    #cs-gallery-{{ section.id }}.cs-tone--custom {
      --cs-g-bg: {{ section.settings.c_bg }};
      --cs-g-heading: {{ section.settings.c_heading }};
      --cs-g-text: {{ section.settings.c_text }};
      --cs-g-accent: {{ section.settings.c_accent }};
      --cs-g-caption: {{ section.settings.c_caption }};
      --cs-g-num: {{ section.settings.c_num }};
      --cs-g-btn-bg: {{ section.settings.c_btn_bg }};
      --cs-g-btn-icon: {{ section.settings.c_btn_icon }};
      --cs-g-btn-border: {{ section.settings.c_btn_border }};
      --cs-g-btn-hover-bg: {{ section.settings.c_btn_hover_bg }};
      --cs-g-btn-hover-icon: {{ section.settings.c_btn_hover_icon }};
      --cs-g-counter: {{ section.settings.c_counter }};
      background-color: var(--cs-g-bg);
      color: var(--cs-g-text);
    }

    /* Heading, eyebrow, intro */
    #cs-gallery-{{ section.id }}.cs-tone--custom h1,
    #cs-gallery-{{ section.id }}.cs-tone--custom h2,
    #cs-gallery-{{ section.id }}.cs-tone--custom h3,
    #cs-gallery-{{ section.id }}.cs-tone--custom [class*="heading"],
    #cs-gallery-{{ section.id }}.cs-tone--custom [class*="title"] {
      color: var(--cs-g-heading);
    }
    #cs-gallery-{{ section.id }}.cs-tone--custom em,
    #cs-gallery-{{ section.id }}.cs-tone--custom [class*="eyebrow"] {
      color: var(--cs-g-accent);
    }
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-text,
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-text p,
    #cs-gallery-{{ section.id }}.cs-tone--custom [class*="head"] p {
      color: var(--cs-g-text);
    }

    /* Slider nav */
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-counter,
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-counter span {
      color: var(--cs-g-counter);
    }
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-icon-btn {
      background-color: var(--cs-g-btn-bg);
      color: var(--cs-g-btn-icon);
      border-color: var(--cs-g-btn-border);
    }
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-icon-btn svg {
      color: var(--cs-g-btn-icon);
      stroke: currentColor;
    }
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-icon-btn:hover,
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-icon-btn:focus-visible {
      background-color: var(--cs-g-btn-hover-bg);
      color: var(--cs-g-btn-hover-icon);
      border-color: var(--cs-g-btn-hover-bg);
    }
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-icon-btn:hover svg,
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-icon-btn:focus-visible svg {
      color: var(--cs-g-btn-hover-icon);
    }

    /* Captions */
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-gallery__caption {
      color: var(--cs-g-caption);
    }
    #cs-gallery-{{ section.id }}.cs-tone--custom .cs-gallery__num {
      color: var(--cs-g-num);
    }
  {%- endstyle -%}
{%- endif -%}

<section
  id="cs-gallery-{{ section.id }}"
  class="cs-section cs-gallery cs-tone--{{ section.settings.tone }} cs-gallery--{{ section.settings.cell_size }}"
  style="--cs-pt: {{ section.settings.padding_top }}px; --cs-pb: {{ section.settings.padding_bottom }}px;"
  data-cs-slider-wrap
>
  <div class="cs-container">
    <div class="cs-gallery__top">
      {%- render 'custom-section-head',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.text
      -%}

      {%- if section.blocks.size > 1 -%}
        <div class="cs-slider-nav">
          <span class="cs-counter"><span data-cs-current>01</span> / <span data-cs-total>{% if section.blocks.size < 10 %}0{% endif %}{{ section.blocks.size }}</span></span>
          <button type="button" class="cs-icon-btn" data-cs-prev aria-label="Previous image">
            {% render 'custom-icon', icon: 'arrow-left' %}
          </button>
          <button type="button" class="cs-icon-btn" data-cs-next aria-label="Next image">
            {% render 'custom-icon', icon: 'arrow-right' %}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div
      class="cs-gallery__slider cs-slider"
      data-cs-slider='{"wrapAround": true, "cellAlign": "center", "contain": false, "autoPlay": {% if section.settings.autoplay %}{{ autoplay_ms }}{% else %}false{% endif %}}'
      {% if section.settings.parallax %}data-cs-parallax{% endif %}
      tabindex="0"
      aria-label="{{ section.settings.heading | strip_html | escape }}"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign placeholder_index = forloop.index0 | modulo: 2 | plus: 1
          assign placeholder_name = 'lifestyle-' | append: placeholder_index
        -%}
        <figure class="cs-gallery__cell" data-cs-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="cs-media cs-gallery__media">
            <div class="cs-gallery__layer" data-cs-parallax-layer>
              {% render 'cs-image', image: block.settings.image, sizes: '(min-width: 990px) 45vw, 85vw', placeholder: placeholder_name %}
            </div>
          </div>
          {%- if block.settings.caption != blank -%}
            <figcaption class="cs-gallery__caption">
              <span class="cs-gallery__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              {{ block.settings.caption | escape }}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Custom Gallery slider",
  "tag": "div",
  "class": "cs-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "On the ground"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Stores are <em>turning</em> nationwide"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-play",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-play speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Parallax images while dragging",
      "default": true
    },
    {
      "type": "select",
      "id": "cell_size",
      "label": "Image size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Colour tone",
      "options": [
        { "value": "light", "label": "White" },
        { "value": "paper", "label": "Paper" },
        { "value": "dark", "label": "Midnight" },
        { "value": "accent", "label": "Saffron" },
        { "value": "onyx", "label": "Onyx" },
        { "value": "custom", "label": "Custom colours" }
      ],
      "default": "light",
      "info": "Choose \"Custom colours\" to pick your own colours below."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Custom colours",
      "info": "Used only when Colour tone is set to \"Custom colours\"."
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Section background",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_heading",
      "label": "Heading",
      "default": "#0F172A",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Intro text",
      "default": "#475569",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_accent",
      "label": "Accent (eyebrow and highlighted word)",
      "default": "#F59E0B",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_counter",
      "label": "Slide counter",
      "default": "#0F172A",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_btn_bg",
      "label": "Arrow button background",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_btn_icon",
      "label": "Arrow button icon",
      "default": "#0F172A",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_btn_border",
      "label": "Arrow button border",
      "default": "#CBD5E1",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_btn_hover_bg",
      "label": "Arrow button hover background",
      "default": "#0F172A",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_btn_hover_icon",
      "label": "Arrow button hover icon",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_caption",
      "label": "Caption text",
      "default": "#334155",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_num",
      "label": "Caption number",
      "default": "#F59E0B",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Gallery slider",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
