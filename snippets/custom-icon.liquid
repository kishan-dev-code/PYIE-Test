{%- comment -%}
  Line icon set for the cs- sections (24x24, stroke = currentColor).

  Usage:
    {% render 'cs-icon', icon: 'rocket' %}
    {% render 'cs-icon', icon: 'arrow-right', class: 'cs-btn__icon' %}
{%- endcomment -%}
{%- if icon != blank and icon != 'none' -%}
<svg class="cs-icon{% if class != blank %} {{ class }}{% endif %}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}
      <path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17L17 7M8 7h9v9"/>
    {%- when 'swap' -%}
      <path d="M4 8h15l-4-4M20 16H5l4 4"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'rocket' -%}
      <path d="M5 15c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2z"/><path d="M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5"/>
    {%- when 'cart' -%}
      <circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h2.6l2.4 11.3a1.6 1.6 0 0 0 1.6 1.2h8.6a1.6 1.6 0 0 0 1.6-1.2L21 7H6"/>
    {%- when 'megaphone' -%}
      <path d="M3 11v3a1 1 0 0 0 1 1h3l6 4V6L7 10H4a1 1 0 0 0-1 1z"/><path d="M17 8.5a5 5 0 0 1 0 7M20 6a8.5 8.5 0 0 1 0 12"/>
    {%- when 'wrench' -%}
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z"/>
    {%- when 'users' -%}
      <circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.4a6.5 6.5 0 0 1 3 5.6"/>
    {%- when 'shield' -%}
      <path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5a14.5 14.5 0 0 1 0 19 14.5 14.5 0 0 1 0-19z"/>
    {%- when 'truck' -%}
      <path d="M2 6h11v10H2zM13 9h4l4 4v3h-8"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'trophy' -%}
      <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3"/>
    {%- when 'star' -%}
      <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>
    {%- when 'bolt' -%}
      <path d="M13 2L4 14h7l-1 8 9-12h-7z"/>
    {%- when 'layers' -%}
      <path d="M12 3l9.5 5L12 13 2.5 8z"/><path d="M2.5 12.5L12 17.5l9.5-5M2.5 16.5L12 21.5l9.5-5"/>
    {%- when 'map-pin' -%}
      <path d="M12 21.5s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9.5" r="2.5"/>
    {%- when 'factory' -%}
      <path d="M2.5 21h19V9l-6 4V9l-6 4V4h-5z"/><path d="M7 17h2M12 17h2M17 17h2"/>
    {%- when 'store' -%}
      <path d="M3 9l1.5-5h15L21 9M3 9v11h18V9M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M9.5 20v-5h5v5"/>
    {%- when 'coffee' -%}
      <path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17M8 2.5v3M12 2.5v3"/>
    {%- when 'printer' -%}
      <path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/>
    {%- when 'cpu' -%}
      <rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>
    {%- when 'chart' -%}
      <path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 6-7"/>
    {%- when 'whatsapp' -%}
      <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"/><path d="M9.2 8.2c.1 2.9 2.7 5.5 5.6 5.6l1-1.4-1.9-.9-.8.7a4.4 4.4 0 0 1-2.3-2.3l.7-.8-.9-1.9z"/>
    {%- when 'headset' -%}
      <path d="M3 14v-2a9 9 0 0 1 18 0v2"/><path d="M3 14h3v6H4a1 1 0 0 1-1-1zM21 14h-3v6h2a1 1 0 0 0 1-1z"/>
    {%- when 'box' -%}
      <path d="M21 8l-9-5-9 5 9 5z"/><path d="M3 8v8l9 5 9-5V8M12 13v8"/>
    {%- when 'monitor' -%}
      <rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/>
    {%- when 'phone' -%}
      <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>
    {%- when 'linkedin' -%}
      <rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>
    {%- else -%}
      <circle cx="12" cy="12" r="4"/>
  {%- endcase -%}
</svg>
{%- endif -%}
