{{ 'custom-marquee.css' | asset_url | stylesheet_tag }}

{%- if section.settings.tone == 'custom' -%}
  {%- style -%}
    /* ---------- Custom colour combination ---------- */
    #cs-marquee-{{ section.id }}.cs-tone--custom {
      --cs-bg: {{ section.settings.c_bg }};
      --cs-fg: {{ section.settings.c_text }};
      --cs-fg-muted: {{ section.settings.c_text | color_modify: 'alpha', 0.62 }};
      --cs-line: {{ section.settings.c_border }};
      --cs-accent: {{ section.settings.c_sep }};
      --cs-accent-text: {{ section.settings.c_sep }};

      color: var(--cs-fg);
      
      {%- if section.settings.c_bg_gradient != blank %}
      background-image: {{ section.settings.c_bg_gradient }};
      background-repeat: no-repeat;
      {%- else %}
      background-image: none;
      {%- endif %}
      background-color: var(--cs-bg);
      {%- if section.settings.c_show_border %}
      border-top: {{ section.settings.c_border_width }}px solid var(--cs-line);
      border-bottom: {{ section.settings.c_border_width }}px solid var(--cs-line);
      {%- endif %}
    }
    #cs-marquee-{{ section.id }}.cs-tone--custom .cs-marquee__item {
      color: var(--cs-fg);
    }
    #cs-marquee-{{ section.id }}.cs-tone--custom .cs-marquee__sep {
      fill: var(--cs-accent);
    }
    #cs-marquee-{{ section.id }}.cs-tone--custom .cs-marquee__item:hover {
      color: {{ section.settings.c_text_hover }};
    }
  {%- endstyle -%}
{%- endif -%}

<section
  id="cs-marquee-{{ section.id }}"
  class="cs-section cs-marquee cs-marquee-wrapper cs-tone--{{ section.settings.tone }}{% if section.settings.reverse %} cs-marquee--reverse{% endif %}"
  style="--cs-pt: {{ section.settings.padding_top }}px; --cs-pb: {{ section.settings.padding_bottom }}px; --cs-marquee-speed: {{ section.settings.speed }}s;"
>
  {%- if section.blocks.size > 0 -%}
    <div class="cs-marquee__track">
      {%- comment -%} Two identical groups so the loop is seamless; the second is hidden from screen readers. {%- endcomment -%}
      {%- for i in (1..2) -%}
        <ul class="cs-marquee__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="cs-marquee__item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
              <span>{{ block.settings.text | escape }}</span>
              <svg class="cs-icon cs-marquee__sep" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"></path></svg>
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Custom Marquee",
  "tag": "div",
  "class": "cs-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Loop duration",
      "info": "Lower is faster.",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Scroll right to left",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Colour tone",
      "options": [
        { "value": "light", "label": "White" },
        { "value": "paper", "label": "Paper" },
        { "value": "dark", "label": "Midnight" },
        { "value": "accent", "label": "Saffron" },
        { "value": "noir", "label": "Noir glow" },
        { "value": "custom", "label": "Custom colours" }
      ],
      "default": "accent",
      "info": "Choose \"Custom colours\" to pick your own colours below."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Custom colours",
      "info": "Used only when Colour tone is set to \"Custom colours\"."
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Background",
      "default": "#050507",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "c_bg_gradient",
      "label": "Background gradient",
      "info": "Optional. Sits on top of the background colour. Leave empty for a flat colour.",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Text",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_text_hover",
      "label": "Text on hover",
      "default": "#FF3B3B",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_sep",
      "label": "Star separator",
      "default": "#FF3B3B",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "c_show_border",
      "label": "Show top & bottom border",
      "default": false,
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_border",
      "label": "Border colour",
      "default": "#2A2A2E",
      "visible_if": "{{ section.settings.tone == 'custom' and section.settings.c_show_border }}"
    },
    {
      "type": "range",
      "id": "c_border_width",
      "label": "Border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.tone == 'custom' and section.settings.c_show_border }}"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pan-India distribution"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Brand launches" } },
        { "type": "item", "settings": { "text": "Compliance & certifications" } },
        { "type": "item", "settings": { "text": "Pan-India distribution" } },
        { "type": "item", "settings": { "text": "After-sales & installation" } }
      ]
    }
  ]
}
{% endschema %}
