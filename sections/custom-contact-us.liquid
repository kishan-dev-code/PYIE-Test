{{ 'custom-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign key = 'cs-contact-' | append: section.id
  assign retailer_id = key | append: '-retailer'
  assign brand_id = key | append: '-brand'

  assign retailer_types = section.settings.retailer_types | split: ','
  assign retailer_categories = section.settings.retailer_categories | split: ','
  assign brand_categories = section.settings.brand_categories | split: ','
  assign brand_services = section.settings.brand_services | split: ','
  assign brand_timelines = section.settings.brand_timelines | split: ','

  assign default_tab = section.settings.default_tab
-%}

{%- style -%}
  {%- if section.settings.tone == 'custom' -%}
  /* ---------- Custom colour combination ---------- */
  #{{ key }}.cs-tone--custom {
    --cs-bg: {{ section.settings.c_bg }};
    --cs-fg: {{ section.settings.c_text }};
    --cs-fg-muted: {{ section.settings.c_text | color_modify: 'alpha', 0.72 }};
    --cs-line: {{ section.settings.c_border }};
    --cs-accent: {{ section.settings.c_accent }};
    --cs-accent-text: {{ section.settings.c_accent }};
    color: var(--cs-fg);
    background-color: var(--cs-bg);
    background-image: none;
  }
#{{ key }}.cs-tone--custom em {
   --cs-accent: {{ section.settings.c_accent }};
    --cs-accent-text: {{ section.settings.c_accent }};
}

#{{ key }}.cs-tone--custom .cs-eyebrow {
  --cs-accent: {{ section.settings.c_accent }};
}

  /* Card + info column */
  #{{ key }}.cs-tone--custom .cs-contact__card {
    background-image: none;
    background-color: {% if section.settings.c_card_bg != blank %}{{ section.settings.c_card_bg }}{% else %}transparent{% endif %};
    border-color: var(--cs-line);
  }
  #{{ key }}.cs-tone--custom .cs-contact__info {
    border-color: var(--cs-line);
  }
  #{{ key }}.cs-tone--custom .cs-eyebrow,
  #{{ key }}.cs-tone--custom .cs-contact__title em { color: var(--cs-accent); }
  #{{ key }}.cs-tone--custom .cs-contact__title,
  #{{ key }}.cs-tone--custom .cs-contact__form-title { color: {{ section.settings.c_heading }}; }
  #{{ key }}.cs-tone--custom :is(.cs-contact__text, .cs-contact__text p, .cs-contact__details, .cs-contact__details address, .cs-contact__panel-intro) {
    color: var(--cs-fg);
  }
  #{{ key }}.cs-tone--custom .cs-contact__details a { color: {{ section.settings.c_link }}; }
  #{{ key }}.cs-tone--custom .cs-contact__details a:hover { color: var(--cs-accent); }
  #{{ key }}.cs-tone--custom .cs-contact__detail-icon {
    background-color: {{ section.settings.c_icon_bg }};
    color: {{ section.settings.c_icon }};
    border-color: {{ section.settings.c_icon_bg }};
  }
  #{{ key }}.cs-tone--custom .cs-contact__detail-icon svg { color: inherit; }

  /* Social icons */
  #{{ key }}.cs-tone--custom .cs-contact__social .cs-icon-btn {
    background-color: {{ section.settings.c_icon_bg }};
    color: {{ section.settings.c_icon }};
    border-color: var(--cs-line);
  }
  #{{ key }}.cs-tone--custom .cs-contact__social .cs-icon-btn:hover,
  #{{ key }}.cs-tone--custom .cs-contact__social .cs-icon-btn:focus-visible {
    background-color: var(--cs-accent);
    color: {{ section.settings.c_btn_text }};
    border-color: var(--cs-accent);
  }
  #{{ key }}.cs-tone--custom .cs-contact__social svg { color: inherit; }

  /* Form panel */
  #{{ key }}.cs-tone--custom .cs-contact__form-wrap {
    border-color: var(--cs-line);
  }

  /* Fields */
  #{{ key }}.cs-tone--custom .cs-field__input {
    background-color: {{ section.settings.c_field_bg }};
    color: {{ section.settings.c_field_text }};
    border-color: {{ section.settings.c_field_border }};
  }
  #{{ key }}.cs-tone--custom .cs-field__input:focus,
  #{{ key }}.cs-tone--custom .cs-field__input:focus-visible {
    border-color: {{ section.settings.c_field_focus }};
    outline-color: {{ section.settings.c_field_focus }};
    box-shadow: 0 0 0 1px {{ section.settings.c_field_focus }};
  }
  #{{ key }}.cs-tone--custom .cs-field__input option {
    background-color: {{ section.settings.c_field_bg }};
    color: {{ section.settings.c_field_text }};
  }
  #{{ key }}.cs-tone--custom .cs-field__label { color: {{ section.settings.c_label }}; }
  #{{ key }}.cs-tone--custom .cs-field__input:focus + .cs-field__label { color: {{ section.settings.c_field_focus }}; }
  #{{ key }}.cs-tone--custom .cs-field__chevron { color: {{ section.settings.c_label }}; }

  /* Submit button */
  #{{ key }}.cs-tone--custom .cs-contact__submit {
    background-color: {{ section.settings.c_btn_bg }};
    color: {{ section.settings.c_btn_text }};
    border-color: {{ section.settings.c_btn_bg }};
  }
  #{{ key }}.cs-tone--custom .cs-contact__submit:hover,
  #{{ key }}.cs-tone--custom .cs-contact__submit:focus-visible {
    background-color: {{ section.settings.c_btn_hover_bg }};
    color: {{ section.settings.c_btn_hover_text }};
    border-color: {{ section.settings.c_btn_hover_bg }};
  }
  #{{ key }}.cs-tone--custom .cs-contact__submit svg { color: inherit; }

  /* Messages */
  #{{ key }}.cs-tone--custom .cs-contact__notice--success {
    background-color: {{ section.settings.c_success | color_modify: 'alpha', 0.12 }};
    color: {{ section.settings.c_success }};
    border-color: {{ section.settings.c_success }};
  }
  #{{ key }}.cs-tone--custom .cs-contact__notice--error,
  #{{ key }}.cs-tone--custom .cs-field__error {
    color: {{ section.settings.c_error }};
    border-color: {{ section.settings.c_error }};
  }
  #{{ key }}.cs-tone--custom .cs-contact__notice--error {
    background-color: {{ section.settings.c_error | color_modify: 'alpha', 0.1 }};
  }
  {%- endif -%}

  /* ---------- Column backgrounds (work with every colour tone) ---------- */
  {%- if section.settings.info_bg != blank %}
  #{{ key }} .cs-contact__info {
    background-image: none;
    background-color: {{ section.settings.info_bg }};
    padding: {{ section.settings.column_padding }}px;
    border-radius: {{ section.settings.column_radius }}px;
    border-bottom-right-radius: 0;
    border-top-right-radius: 0;
  }
  {%- endif %}
  {%- if section.settings.form_bg != blank %}
  #{{ key }} .cs-contact__form-wrap {
    background-image: none;
    background-color: {{ section.settings.form_bg }};
    padding: {{ section.settings.column_padding }}px;
    border-radius: {{ section.settings.column_radius }}px;
    border-bottom-left-radius: 0;
    border-top-left-radius: 0;
  }
  {%- endif %}
  @media screen and (max-width: 749px) {
    {%- if section.settings.info_bg != blank %}
    #{{ key }} .cs-contact__info { padding: {{ section.settings.column_padding | times: 0.6 | round }}px; }
    {%- endif %}
    {%- if section.settings.form_bg != blank %}
    #{{ key }} .cs-contact__form-wrap { padding: {{ section.settings.column_padding | times: 0.6 | round }}px; }
    {%- endif %}
  }

  /* ---------- Retailer / Brand tabs ---------- */
  #{{ key }} .cs-contact__tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    margin: 0 0 28px;
    border: 1px solid var(--cs-line, rgba(15, 23, 42, 0.12));
    border-radius: 999px;
    {%- if section.settings.tab_bg != blank %}
    background-color: {{ section.settings.tab_bg }};
    {%- endif %}
    width: 100%;
  }
  #{{ key }} .cs-contact__tab {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: {% if section.settings.tab_text != blank %}{{ section.settings.tab_text }}{% else %}inherit{% endif %};
    font: inherit;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    opacity: 0.72;
    transition: background-color 0.25s ease, color 0.25s ease, opacity 0.25s ease;
    flex: 1 auto;
  }
  #{{ key }} .cs-contact__tab:hover { opacity: 1; }
  #{{ key }} .cs-contact__tab:focus-visible {
    outline: 2px solid var(--cs-accent, #F59E0B);
    outline-offset: 2px;
  }
  #{{ key }} .cs-contact__tab[aria-selected="true"] {
    opacity: 1;
    background-color: {% if section.settings.tab_active_bg != blank %}{{ section.settings.tab_active_bg }}{% else %}var(--cs-accent, #F59E0B){% endif %};
    color: {% if section.settings.tab_active_text != blank %}{{ section.settings.tab_active_text }}{% else %}#0F172A{% endif %};
  }
  #{{ key }} .cs-contact__tab svg,
  #{{ key }} .cs-contact__tab .cs-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  #{{ key }} .cs-contact__panel[hidden] { display: none; }
  #{{ key }} .cs-contact__panel.is-entering {
    animation: cs-contact-fade 0.35s ease both;
  }
  #{{ key }} .cs-contact__panel-intro {
    margin: -8px 0 20px;
    opacity: 0.8;
  }
  @keyframes cs-contact-fade {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #{{ key }} .cs-contact__panel.is-entering { animation: none; }
  }
  @media screen and (max-width: 749px) {
    #{{ key }} .cs-contact__tabs { display: flex; width: 100%; }
    #{{ key }} .cs-contact__tab { flex: 1 1 0; padding: 12px 14px; }
  }

@media (max-width:989px) {
  #{{ key }} .cs-contact__info { 
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
  }

  #{{ key }} .cs-contact__form-wrap { 
    border-top-right-radius: 0;
    border-top-left-radius: 0;
  }
}

{%- endstyle -%}

<section
  id="{{ key }}"
  class="cs-section cs-contact cs-tone--{{ section.settings.tone }}"
  style="--cs-pt: {{ section.settings.padding_top }}px; --cs-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="cs-container">
    <div class="cs-contact__card">
      {%- comment -%} ---------- Left: info column ---------- {%- endcomment -%}
      <div class="cs-contact__info" data-cs-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cs-title cs-contact__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cs-text cs-contact__text">{{ section.settings.text }}</div>
        {%- endif -%}

        <ul class="cs-contact__details">
          {%- if section.settings.address != blank -%}
            <li>
              <span class="cs-contact__detail-icon">{% render 'custom-icon', icon: 'map-pin' %}</span>
              <address>{{ section.settings.address | newline_to_br }}</address>
            </li>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <li>
              <span class="cs-contact__detail-icon">{% render 'custom-icon', icon: 'mail' %}</span>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li>
              <span class="cs-contact__detail-icon">{% render 'custom-icon', icon: 'phone' %}</span>
              <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
            </li>
          {%- endif -%}
        </ul>

        {%- if section.settings.instagram_url != blank or section.settings.linkedin_url != blank -%}
          <div class="cs-contact__social">
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" class="cs-icon-btn" target="_blank" rel="noopener" aria-label="Instagram">
                {% render 'custom-icon', icon: 'instagram' %}
              </a>
            {%- endif -%}
            {%- if section.settings.linkedin_url != blank -%}
              <a href="{{ section.settings.linkedin_url }}" class="cs-icon-btn" target="_blank" rel="noopener" aria-label="LinkedIn">
                {% render 'custom-icon', icon: 'linkedin' %}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- Right: tabs + forms ---------- {%- endcomment -%}
      <div class="cs-contact__form-wrap" data-cs-reveal style="--cs-delay: 120ms;">
        <div class="cs-contact__tabs" role="tablist" aria-label="{{ section.settings.tabs_aria_label | escape }}">
          <button
            type="button"
            class="cs-contact__tab"
            role="tab"
            id="{{ retailer_id }}-tab"
            aria-controls="{{ retailer_id }}-panel"
            aria-selected="{% if default_tab == 'retailer' %}true{% else %}false{% endif %}"
            tabindex="{% if default_tab == 'retailer' %}0{% else %}-1{% endif %}"
            data-cs-tab="retailer"
          >
            {%- if section.settings.show_tab_icons -%}{% render 'custom-icon', icon: 'store' %}{%- endif -%}
            <span>{{ section.settings.retailer_tab_label | escape }}</span>
          </button>
          <button
            type="button"
            class="cs-contact__tab"
            role="tab"
            id="{{ brand_id }}-tab"
            aria-controls="{{ brand_id }}-panel"
            aria-selected="{% if default_tab == 'brand' %}true{% else %}false{% endif %}"
            tabindex="{% if default_tab == 'brand' %}0{% else %}-1{% endif %}"
            data-cs-tab="brand"
          >
            {%- if section.settings.show_tab_icons -%}{% render 'custom-icon', icon: 'globe' %}{%- endif -%}
            <span>{{ section.settings.brand_tab_label | escape }}</span>
          </button>
        </div>

        {%- comment -%} ===================== RETAILER FORM ===================== {%- endcomment -%}
        <div
          class="cs-contact__panel"
          role="tabpanel"
          id="{{ retailer_id }}-panel"
          aria-labelledby="{{ retailer_id }}-tab"
          data-cs-panel="retailer"
          tabindex="0"
          {% if default_tab != 'retailer' %}hidden{% endif %}
        >
          {%- form 'contact', id: retailer_id, class: 'cs-contact__form' -%}
            <input type="hidden" name="contact[Enquiry type]" value="Retailer">

            {%- if form.posted_successfully? -%}
              <div class="cs-contact__notice cs-contact__notice--success" role="status" tabindex="-1" data-cs-notice>
                {% render 'custom-icon', icon: 'check' %}
                <span>{{ section.settings.retailer_success | default: 'Thanks — our retail team will be in touch shortly.' }}</span>
              </div>
            {%- elsif form.errors -%}
              <div class="cs-contact__notice cs-contact__notice--error" role="alert" tabindex="-1" data-cs-notice>
                <p>{{ 'templates.contact.form.error_heading' | t }}</p>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- if section.settings.retailer_heading != blank -%}
              <h3 class="cs-contact__form-title">{{ section.settings.retailer_heading }}</h3>
            {%- endif -%}
            {%- if section.settings.retailer_intro != blank -%}
              <p class="cs-contact__panel-intro">{{ section.settings.retailer_intro }}</p>
            {%- endif -%}

            <div class="cs-contact__grid">
              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ retailer_id }}-name" name="contact[Name]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  autocomplete="name" placeholder=" " required>
                <label class="cs-field__label" for="{{ retailer_id }}-name">Full name *</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="email" id="{{ retailer_id }}-email" name="contact[email]"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  autocomplete="email" spellcheck="false" autocapitalize="off" placeholder=" " required
                  {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ retailer_id }}-email-error"{% endif %}>
                <label class="cs-field__label" for="{{ retailer_id }}-email">Email *</label>
                {%- if form.errors contains 'email' -%}
                  <small class="cs-field__error" id="{{ retailer_id }}-email-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>
                {%- endif -%}
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="tel" id="{{ retailer_id }}-phone" name="contact[Phone]"
                  value="{% if customer %}{{ customer.phone }}{% endif %}"
                  autocomplete="tel" pattern="[0-9\-\+\s]*" placeholder=" " required>
                <label class="cs-field__label" for="{{ retailer_id }}-phone">Phone *</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ retailer_id }}-store" name="contact[Store / business name]"
                  autocomplete="organization" placeholder=" " required>
                <label class="cs-field__label" for="{{ retailer_id }}-store">Store / business name *</label>
              </div>

              {%- if retailer_types.size > 0 -%}
                <div class="cs-field cs-field--select">
                  <select class="cs-field__input" id="{{ retailer_id }}-type" name="contact[Store type]">
                    {%- for item in retailer_types -%}
                      <option value="{{ item | strip | escape }}">{{ item | strip }}</option>
                    {%- endfor -%}
                  </select>
                  <label class="cs-field__label cs-field__label--static" for="{{ retailer_id }}-type">Store type</label>
                  {% render 'custom-icon', icon: 'arrow-right', class: 'cs-field__chevron' %}
                </div>
              {%- endif -%}

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ retailer_id }}-gst" name="contact[GST number]"
                  autocapitalize="characters" spellcheck="false" maxlength="15" placeholder=" ">
                <label class="cs-field__label" for="{{ retailer_id }}-gst">GST number</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ retailer_id }}-city" name="contact[City]"
                  autocomplete="address-level2" placeholder=" " required>
                <label class="cs-field__label" for="{{ retailer_id }}-city">City *</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ retailer_id }}-state" name="contact[State]"
                  autocomplete="address-level1" placeholder=" " required>
                <label class="cs-field__label" for="{{ retailer_id }}-state">State *</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ retailer_id }}-stores" name="contact[Number of stores]"
                  inputmode="numeric" placeholder=" ">
                <label class="cs-field__label" for="{{ retailer_id }}-stores">Number of stores</label>
              </div>

              {%- if retailer_categories.size > 0 -%}
                <div class="cs-field cs-field--select">
                  <select class="cs-field__input" id="{{ retailer_id }}-category" name="contact[Categories to stock]">
                    {%- for item in retailer_categories -%}
                      <option value="{{ item | strip | escape }}">{{ item | strip }}</option>
                    {%- endfor -%}
                  </select>
                  <label class="cs-field__label cs-field__label--static" for="{{ retailer_id }}-category">Categories you want to stock</label>
                  {% render 'custom-icon', icon: 'arrow-right', class: 'cs-field__chevron' %}
                </div>
              {%- endif -%}

              <div class="cs-field cs-field--full">
                <input class="cs-field__input" type="text" id="{{ retailer_id }}-brands" name="contact[Brands currently stocked]"
                  placeholder=" ">
                <label class="cs-field__label" for="{{ retailer_id }}-brands">Brands you currently stock</label>
              </div>

              <div class="cs-field cs-field--full">
                <textarea class="cs-field__input cs-field__input--area" rows="4" id="{{ retailer_id }}-body"
                  name="contact[body]" placeholder=" ">{{- form.body -}}</textarea>
                <label class="cs-field__label" for="{{ retailer_id }}-body">Tell us about your store</label>
              </div>
            </div>

            <button type="submit" class="cs-btn cs-btn--primary cs-contact__submit">
              {{- section.settings.retailer_submit | default: 'Submit' | escape -}}
              {% render 'custom-icon', icon: 'arrow-right' %}
            </button>
          {%- endform -%}
        </div>

        {%- comment -%} ===================== BRAND FORM ===================== {%- endcomment -%}
        <div
          class="cs-contact__panel"
          role="tabpanel"
          id="{{ brand_id }}-panel"
          aria-labelledby="{{ brand_id }}-tab"
          data-cs-panel="brand"
          tabindex="0"
          {% if default_tab != 'brand' %}hidden{% endif %}
        >
          {%- form 'contact', id: brand_id, class: 'cs-contact__form' -%}
            <input type="hidden" name="contact[Enquiry type]" value="Brand">

            {%- if form.posted_successfully? -%}
              <div class="cs-contact__notice cs-contact__notice--success" role="status" tabindex="-1" data-cs-notice>
                {% render 'custom-icon', icon: 'check' %}
                <span>{{ section.settings.brand_success | default: 'Thanks — our partnerships team will be in touch shortly.' }}</span>
              </div>
            {%- elsif form.errors -%}
              <div class="cs-contact__notice cs-contact__notice--error" role="alert" tabindex="-1" data-cs-notice>
                <p>{{ 'templates.contact.form.error_heading' | t }}</p>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- if section.settings.brand_heading != blank -%}
              <h3 class="cs-contact__form-title">{{ section.settings.brand_heading }}</h3>
            {%- endif -%}
            {%- if section.settings.brand_intro != blank -%}
              <p class="cs-contact__panel-intro">{{ section.settings.brand_intro }}</p>
            {%- endif -%}

            <div class="cs-contact__grid">
              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ brand_id }}-name" name="contact[Name]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  autocomplete="name" placeholder=" " required>
                <label class="cs-field__label" for="{{ brand_id }}-name">Full name *</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ brand_id }}-role" name="contact[Designation]"
                  autocomplete="organization-title" placeholder=" ">
                <label class="cs-field__label" for="{{ brand_id }}-role">Designation</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="email" id="{{ brand_id }}-email" name="contact[email]"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  autocomplete="email" spellcheck="false" autocapitalize="off" placeholder=" " required
                  {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ brand_id }}-email-error"{% endif %}>
                <label class="cs-field__label" for="{{ brand_id }}-email">Work email *</label>
                {%- if form.errors contains 'email' -%}
                  <small class="cs-field__error" id="{{ brand_id }}-email-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>
                {%- endif -%}
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="tel" id="{{ brand_id }}-phone" name="contact[Phone]"
                  value="{% if customer %}{{ customer.phone }}{% endif %}"
                  autocomplete="tel" pattern="[0-9\-\+\s]*" placeholder=" " required>
                <label class="cs-field__label" for="{{ brand_id }}-phone">Phone (with country code) *</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ brand_id }}-brand" name="contact[Brand name]"
                  autocomplete="organization" placeholder=" " required>
                <label class="cs-field__label" for="{{ brand_id }}-brand">Brand name *</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="url" id="{{ brand_id }}-website" name="contact[Website]"
                  autocomplete="url" spellcheck="false" autocapitalize="off" placeholder=" ">
                <label class="cs-field__label" for="{{ brand_id }}-website">Website</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ brand_id }}-country" name="contact[Country of origin]"
                  autocomplete="country-name" placeholder=" " required>
                <label class="cs-field__label" for="{{ brand_id }}-country">Country of origin *</label>
              </div>

              <div class="cs-field">
                <input class="cs-field__input" type="text" id="{{ brand_id }}-markets" name="contact[Current markets]"
                  placeholder=" ">
                <label class="cs-field__label" for="{{ brand_id }}-markets">Markets you sell in today</label>
              </div>

              {%- if brand_categories.size > 0 -%}
                <div class="cs-field cs-field--select">
                  <select class="cs-field__input" id="{{ brand_id }}-category" name="contact[Product category]">
                    {%- for item in brand_categories -%}
                      <option value="{{ item | strip | escape }}">{{ item | strip }}</option>
                    {%- endfor -%}
                  </select>
                  <label class="cs-field__label cs-field__label--static" for="{{ brand_id }}-category">Product category</label>
                  {% render 'custom-icon', icon: 'arrow-right', class: 'cs-field__chevron' %}
                </div>
              {%- endif -%}

              {%- if brand_services.size > 0 -%}
                <div class="cs-field cs-field--select">
                  <select class="cs-field__input" id="{{ brand_id }}-service" name="contact[Support needed]">
                    {%- for item in brand_services -%}
                      <option value="{{ item | strip | escape }}">{{ item | strip }}</option>
                    {%- endfor -%}
                  </select>
                  <label class="cs-field__label cs-field__label--static" for="{{ brand_id }}-service">What support do you need?</label>
                  {% render 'custom-icon', icon: 'arrow-right', class: 'cs-field__chevron' %}
                </div>
              {%- endif -%}

              {%- if brand_timelines.size > 0 -%}
                <div class="cs-field cs-field--full cs-field--select">
                  <select class="cs-field__input" id="{{ brand_id }}-timeline" name="contact[India launch timeline]">
                    {%- for item in brand_timelines -%}
                      <option value="{{ item | strip | escape }}">{{ item | strip }}</option>
                    {%- endfor -%}
                  </select>
                  <label class="cs-field__label cs-field__label--static" for="{{ brand_id }}-timeline">When do you plan to launch in India?</label>
                  {% render 'custom-icon', icon: 'arrow-right', class: 'cs-field__chevron' %}
                </div>
              {%- endif -%}

              <div class="cs-field cs-field--full">
                <textarea class="cs-field__input cs-field__input--area" rows="4" id="{{ brand_id }}-body"
                  name="contact[body]" placeholder=" ">{{- form.body -}}</textarea>
                <label class="cs-field__label" for="{{ brand_id }}-body">Tell us about your brand and products</label>
              </div>
            </div>

            <button type="submit" class="cs-btn cs-btn--primary cs-contact__submit">
              {{- section.settings.brand_submit | default: 'Submit' | escape -}}
              {% render 'custom-icon', icon: 'arrow-right' %}
            </button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('{{ key }}');
    if (!root || root.hasAttribute('data-cs-tabs-ready')) return;
    root.setAttribute('data-cs-tabs-ready', '');

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-cs-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-cs-panel]'));

    function activate(name, focusTab) {
      tabs.forEach(function (tab) {
        var on = tab.getAttribute('data-cs-tab') === name;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.setAttribute('tabindex', on ? '0' : '-1');
        if (on && focusTab) tab.focus();
      });
      panels.forEach(function (panel) {
        var on = panel.getAttribute('data-cs-panel') === name;
        if (on && panel.hidden) {
          panel.hidden = false;
          panel.classList.remove('is-entering');
          void panel.offsetWidth;
          panel.classList.add('is-entering');
        } else if (!on) {
          panel.hidden = true;
        }
      });
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        activate(tab.getAttribute('data-cs-tab'));
      });
      tab.addEventListener('keydown', function (e) {
        var next = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = tabs[(i + 1) % tabs.length];
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = tabs[(i - 1 + tabs.length) % tabs.length];
        if (e.key === 'Home') next = tabs[0];
        if (e.key === 'End') next = tabs[tabs.length - 1];
        if (next) {
          e.preventDefault();
          activate(next.getAttribute('data-cs-tab'), true);
        }
      });
    });

    // After submitting, the page reloads: reopen the tab whose form shows a message.
    var notice = root.querySelector('[data-cs-notice]');
    var hashTarget = null;
    try {
      var hashId = window.location.hash.slice(1);
      if (hashId) hashTarget = root.querySelector('[id="' + hashId.replace(/"/g, '') + '"]');
    } catch (err) {}
    var owner = (notice || hashTarget) ? (notice || hashTarget).closest('[data-cs-panel]') : null;
    if (owner) {
      activate(owner.getAttribute('data-cs-panel'));
      if (notice) notice.focus({ preventScroll: false });
    }

    // Links like /pages/contact#retailer or #brand (e.g. from the footer) open the matching tab
    // and scroll the form into view.
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function fromHash(scroll) {
      var name = null;
      if (window.location.hash === '#retailer') name = 'retailer';
      if (window.location.hash === '#brand') name = 'brand';
      if (!name) return;
      activate(name);
      if (scroll) {
        var target = root.querySelector('[data-cs-panel="' + name + '"]') || root;
        var wrap = target.closest('.cs-contact__form-wrap') || target;
        setTimeout(function () {
          wrap.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        }, 60);
      }
    }
    fromHash(true);
    window.addEventListener('hashchange', function () { fromHash(true); });

    // Same-page clicks on #retailer / #brand links (hashchange doesn't fire if the hash is already set)
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href$="#retailer"], a[href$="#brand"]');
      if (!link) return;
      var url;
      try { url = new URL(link.href, window.location.href); } catch (err) { return; }
      if (url.pathname !== window.location.pathname || url.hash !== window.location.hash) return;
      e.preventDefault();
      fromHash(true);
    });

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') fromHash(false);
    });
  })();
</script>

