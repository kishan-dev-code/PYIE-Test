      "default": 183
    },
    {
      "type": "text",
      "id": "cagr",
      "label": "CAGR %",
      "default": "7.8"
    },
    {
      "type": "text",
      "id": "unit_prefix",
      "label": "Value prefix",
      "default": "$"
    },
    {
      "type": "text",
      "id": "unit_suffix",
      "label": "Value suffix",
      "default": "B"
    },
    {
      "type": "text",
      "id": "chart_note",
      "label": "Chart note",
      "default": "7.8% CAGR through 2033, reaching $183B."
    },
    {
      "type": "header",
      "content": "Why now"
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Heading",
      "default": "Why now?"
    },
    {
      "type": "inline_richtext",
      "id": "closing",
