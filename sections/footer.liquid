{{ 'custom-footer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand_name = section.settings.logo_text | default: shop.name
  assign current_year = 'now' | date: '%Y'
  assign footer_id = 'cs-footer-' | append: section.id
  assign wa_url = blank
  if section.settings.whatsapp_number != blank
    assign wa_digits = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
    assign wa_url = 'https://wa.me/' | append: wa_digits
    if section.settings.whatsapp_message != blank
      assign wa_text = section.settings.whatsapp_message | url_encode | replace: '+', '%20'
      assign wa_url = wa_url | append: '?text=' | append: wa_text
    endif
  endif

  # WhatsApp shows as the large button when it has a label, otherwise as a social icon
  assign wa_as_icon = false
  assign wa_as_button = false
  if wa_url != blank
    if section.settings.whatsapp_label == blank
      assign wa_as_icon = true
    else
      assign wa_as_button = true
    endif
  endif

  assign has_social = false
  if section.settings.instagram_url != blank or section.settings.linkedin_url != blank or section.settings.youtube_url != blank or wa_as_icon
    assign has_social = true
  endif

  # CTA buttons: both point to the Contact page and open the matching tab (#retailer / #brand)
  assign contact_base = section.settings.cta_link | default: '/pages/contact' | split: '#' | first
  assign retailer_url = contact_base | append: '#retailer'
  assign brand_url = contact_base | append: '#brand'
-%}

{%- style -%}
  /* ---------- Two CTA buttons ---------- */
  #{{ footer_id }} .cs-footer__cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  #{{ footer_id }} .cs-footer__cta-btn--secondary {
    background-color: transparent;
    color: inherit;
    border: 1px solid currentColor;
  }
  #{{ footer_id }} .cs-footer__cta-btn--secondary .cs-footer__cta-arrow {
    background: transparent;
    color: inherit;
  }
  @media screen and (max-width: 749px) {
    #{{ footer_id }} .cs-footer__cta-actions { width: 100%; }
    #{{ footer_id }} .cs-footer__cta-actions .cs-footer__cta-btn { flex: 1 1 100%; justify-content: space-between; }
  }

  {%- if section.settings.tone == 'custom' -%}
    /* ---------- Custom colour combination ---------- */
    #{{ footer_id }}.cs-tone--custom {
      --cs-bg: {{ section.settings.c_bg }};
      --cs-fg: {{ section.settings.c_text }};
      --cs-fg-muted: {{ section.settings.c_muted }};
      --cs-line: {{ section.settings.c_border }};
      --cs-accent: {{ section.settings.c_accent }};
      --cs-accent-text: {{ section.settings.c_accent }};
      color: var(--cs-fg);
      background-color: var(--cs-bg);
      background-image: none;
    }

    /* General text + links */
    #{{ footer_id }}.cs-tone--custom .cs-footer__wordmark,
    #{{ footer_id }}.cs-tone--custom .cs-footer__heading {
      color: {{ section.settings.c_heading }};
    }
    #{{ footer_id }}.cs-tone--custom :is(.cs-footer__about, .cs-footer__about p, .cs-footer__text, .cs-footer__text p, .cs-footer__contact, .cs-footer__contact address) {
      color: var(--cs-fg-muted);
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__tagline { color: var(--cs-accent); }
    #{{ footer_id }}.cs-tone--custom :is(.cs-footer__link, .cs-footer__contact a) {
      color: var(--cs-fg);
    }
    #{{ footer_id }}.cs-tone--custom :is(.cs-footer__link:hover, .cs-footer__link.is-active, .cs-footer__contact a:hover, .cs-footer__policies a:hover) {
      color: {{ section.settings.c_link_hover }};
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__contact svg { color: var(--cs-accent); }
    #{{ footer_id }}.cs-tone--custom :is(.cs-footer__grid, .cs-footer__bottom, .cs-footer__col) {
      border-color: var(--cs-line);
    }

    /* CTA banner */
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta {
      background: {% if section.settings.c_cta_bg != blank %}{{ section.settings.c_cta_bg }}{% else %}transparent{% endif %};
      border-color: var(--cs-line);
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-title { color: {{ section.settings.c_cta_title }}; }
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-title em { color: #FFFFFF; }
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-text { color: {{ section.settings.c_cta_text }}; }

    /* CTA button 1 – Retailer (primary) */
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn--primary {
      background-color: {{ section.settings.c_cta_btn_bg }};
      color: {{ section.settings.c_cta_btn_text }};
      border-color: {{ section.settings.c_cta_btn_bg }};
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn--primary:hover,
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn--primary:focus-visible {
      background-color: {{ section.settings.c_cta_btn_hover_bg }};
      color: {{ section.settings.c_cta_btn_hover_text }};
      border-color: {{ section.settings.c_cta_btn_hover_bg }};
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn svg { color: inherit; }
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn--primary .cs-footer__cta-arrow {
      background: #fff;
      color: #00ABE4;
    }

    /* CTA button 2 – Brand (secondary) */
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn--secondary {
      background-color: {% if section.settings.c_cta_btn2_bg != blank %}{{ section.settings.c_cta_btn2_bg }}{% else %}transparent{% endif %};
      color: {{ section.settings.c_cta_btn2_text }};
      border-color: {{ section.settings.c_cta_btn2_border }};
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn--secondary .cs-footer__cta-arrow {
      background: transparent;
      color: inherit;
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn--secondary:hover,
    #{{ footer_id }}.cs-tone--custom .cs-footer__cta-btn--secondary:focus-visible {
      background-color: {{ section.settings.c_cta_btn2_hover_bg }};
      color: {{ section.settings.c_cta_btn2_hover_text }};
      border-color: {{ section.settings.c_cta_btn2_hover_bg }};
    }

    /* Social icons + back-to-top */
    #{{ footer_id }}.cs-tone--custom .cs-icon-btn {
      background-color: {{ section.settings.c_icon_bg }};
      color: {{ section.settings.c_icon }};
      border-color: var(--cs-line);
    }
    #{{ footer_id }}.cs-tone--custom .cs-icon-btn svg { color: inherit; }
    #{{ footer_id }}.cs-tone--custom .cs-icon-btn:hover,
    #{{ footer_id }}.cs-tone--custom .cs-icon-btn:focus-visible {
      background-color: {{ section.settings.c_icon_hover_bg }};
      color: {{ section.settings.c_icon_hover }};
      border-color: {{ section.settings.c_icon_hover_bg }};
    }

    /* WhatsApp button */
    #{{ footer_id }}.cs-tone--custom .cs-footer__whatsapp {
      background-color: {{ section.settings.c_wa_bg }};
      color: {{ section.settings.c_wa_text }};
      border-color: {{ section.settings.c_wa_bg }};
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__whatsapp :is(.cs-footer__whatsapp-label, .cs-footer__whatsapp-number, svg) {
      color: {{ section.settings.c_wa_text }};
    }

    /* Newsletter */
    #{{ footer_id }}.cs-tone--custom .cs-footer__field {
      background-color: {{ section.settings.c_input_bg }};
      border-color: {{ section.settings.c_input_border }};
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__input {
      background-color: transparent;
      color: {{ section.settings.c_input_text }};
      border-color: {{ section.settings.c_input_border }};
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__input::placeholder {
      color: {{ section.settings.c_input_text }};
      opacity: 0.6;
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__submit {
      background-color: {{ section.settings.c_submit_bg }};
      color: {{ section.settings.c_submit_icon }};
      border-color: {{ section.settings.c_submit_bg }};
    }
    #{{ footer_id }}.cs-tone--custom .cs-footer__submit svg { color: inherit; }
    #{{ footer_id }}.cs-tone--custom .cs-footer__notice { color: var(--cs-accent); }

    /* Oversized wordmark */
    #{{ footer_id }}.cs-tone--custom .cs-footer__giant,
    #{{ footer_id }}.cs-tone--custom .cs-footer__giant span {
      color: {{ section.settings.c_giant }};
      -webkit-text-stroke-color: {{ section.settings.c_giant }};
    }

    /* Bottom bar */
    #{{ footer_id }}.cs-tone--custom .cs-footer__bottom {
      {%- if section.settings.c_bottom_bg != blank %}
      background: {{ section.settings.c_bottom_bg }};
      {%- endif %}
    }
    #{{ footer_id }}.cs-tone--custom :is(.cs-footer__copy, .cs-footer__policies a) {
      color: {{ section.settings.c_bottom_text }};
    }
  {%- endif -%}
{%- endstyle -%}

<footer
  id="{{ footer_id }}"
  class="cs-footer cs-tone--{{ section.settings.tone }}"
  style="--cs-pt: {{ section.settings.padding_top }}px;"
>
  {%- if section.settings.cta_heading != blank -%}
    <div class="cs-container">
      <div class="cs-footer__cta" data-cs-reveal>
        <div class="cs-footer__cta-copy">
          <h2 class="cs-footer__cta-title">{{ section.settings.cta_heading }}</h2>
          {%- if section.settings.cta_text != blank -%}
            <p class="cs-footer__cta-text">{{ section.settings.cta_text }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.retailer_btn_label != blank or section.settings.brand_btn_label != blank -%}
          <div class="cs-footer__cta-actions">
            {%- if section.settings.retailer_btn_label != blank -%}
              <a class="cs-footer__cta-btn cs-footer__cta-btn--primary" href="{{ retailer_url }}">
                <span>{{ section.settings.retailer_btn_label | escape }}</span>
                <span class="cs-footer__cta-arrow">{% render 'custom-icon', icon: 'arrow-up-right' %}</span>
              </a>
            {%- endif -%}
            {%- if section.settings.brand_btn_label != blank -%}
              <a class="cs-footer__cta-btn cs-footer__cta-btn--secondary" href="{{ brand_url }}">
                <span>{{ section.settings.brand_btn_label | escape }}</span>
                <span class="cs-footer__cta-arrow">{% render 'custom-icon', icon: 'arrow-up-right' %}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="cs-container cs-footer__grid" style="--cs-cols: {{ section.blocks.size | at_least: 1 }};">
    <div class="cs-footer__brand">
      <a href="{{ routes.root_url }}" class="cs-footer__logo">
        {%- if section.settings.logo != blank -%}
          <span class="cs-footer__logo-media" style="--cs-logo-w: {{ section.settings.logo_width }}px;">
            {%- assign logo_width_2x = section.settings.logo_width | times: 2 -%}
            {{ section.settings.logo | image_url: width: logo_width_2x | image_tag: alt: brand_name, loading: 'lazy' }}
          </span>
        {%- else -%}
          <span class="cs-footer__wordmark">{{ brand_name | escape }}</span>
        {%- endif -%}
      </a>

      {%- if section.settings.about != blank -%}
        <div class="cs-footer__about">{{ section.settings.about }}</div>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="cs-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- if has_social -%}
        <ul class="cs-footer__social" role="list">
          {%- if section.settings.instagram_url != blank -%}
            <li>
              <a href="{{ section.settings.instagram_url }}" class="cs-icon-btn" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.instagram' | t }}">
                {% render 'custom-icon', icon: 'instagram' %}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.linkedin_url != blank -%}
            <li>
              <a href="{{ section.settings.linkedin_url }}" class="cs-icon-btn" target="_blank" rel="noopener" aria-label="LinkedIn">
                {% render 'custom-icon', icon: 'linkedin' %}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <li>
              <a href="{{ section.settings.youtube_url }}" class="cs-icon-btn" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.youtube' | t }}">
                {% render 'custom-icon', icon: 'youtube' %}
              </a>
            </li>
          {%- endif -%}
          {%- if wa_as_icon -%}
            <li>
              <a href="{{ wa_url }}" class="cs-icon-btn cs-footer__wa-icon" target="_blank" rel="noopener" aria-label="WhatsApp">
                {% render 'custom-icon', icon: 'whatsapp' %}
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- if wa_as_button -%}
        <a href="{{ wa_url }}" class="cs-footer__whatsapp" target="_blank" rel="noopener">
          <span class="cs-footer__whatsapp-icon">{% render 'custom-icon', icon: 'whatsapp' %}</span>
          <span class="cs-footer__whatsapp-copy">
            <span class="cs-footer__whatsapp-label">{{ section.settings.whatsapp_label | escape }}</span>
            <span class="cs-footer__whatsapp-number">{{ section.settings.whatsapp_number | escape }}</span>
          </span>
          {% render 'custom-icon', icon: 'arrow-up-right', class: 'cs-footer__whatsapp-arrow' %}
        </a>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="cs-footer__col cs-footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h3 class="cs-footer__heading">{{ block.settings.heading }}</h3>
        {%- endif -%}

        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- if block.settings.menu.links.size > 0 -%}
              <ul class="cs-footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="cs-footer__link{% if link.active %} is-active{% endif %}" {% if link.current %}aria-current="page"{% endif %}>
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'contact' -%}
            <ul class="cs-footer__contact" role="list">
              {%- if block.settings.address != blank -%}
                <li>
                  {% render 'custom-icon', icon: 'map-pin' %}
                  <address>{{ block.settings.address | newline_to_br }}</address>
                </li>
              {%- endif -%}
              {%- if block.settings.email != blank -%}
                <li>
                  {% render 'custom-icon', icon: 'mail' %}
                  <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                </li>
              {%- endif -%}
              {%- if block.settings.phone != blank -%}
                <li>
                  {% render 'custom-icon', icon: 'phone' %}
                  <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                </li>
              {%- endif -%}
            </ul>

          {%- when 'newsletter' -%}
            {%- if block.settings.text != blank -%}
              <p class="cs-footer__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- assign newsletter_id = 'cs-newsletter-' | append: block.id -%}
            {%- form 'customer', id: newsletter_id, class: 'cs-footer__newsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="cs-footer__notice" role="status" tabindex="-1" autofocus>
                  {% render 'custom-icon', icon: 'check' %}
                  {{ 'newsletter.success' | t }}
                </p>
              {%- else -%}
                <div class="cs-footer__field">
                  <label class="cs-visually-hidden" for="{{ newsletter_id }}-email">{{ 'newsletter.label' | t }}</label>
                  <input
                    id="{{ newsletter_id }}-email"
                    class="cs-footer__input"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    autocomplete="email"
                    autocapitalize="off"
                    spellcheck="false"
                    required
                    {% if form.errors %}aria-invalid="true" aria-describedby="{{ newsletter_id }}-error"{% endif %}
                  >
                  <button type="submit" class="cs-footer__submit" aria-label="{{ block.settings.button_label | escape }}">
                    {% render 'custom-icon', icon: 'arrow-right' %}
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="cs-footer__error" id="{{ newsletter_id }}-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}

          {%- when 'text' -%}
            <div class="cs-footer__text">{{ block.settings.text }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_wordmark -%}
    <div class="cs-footer__giant" aria-hidden="true">
      <span>{{ section.settings.wordmark_text | default: brand_name }}</span>
    </div>
  {%- endif -%}

  <div class="cs-container cs-footer__bottom">
    <p class="cs-footer__copy">
      &copy; {{ current_year }}
      {{ brand_name | escape -}}
      {%- if section.settings.copyright != blank %}. {{ section.settings.copyright }}{% endif %}
    </p>

    {%- if section.settings.show_policies and shop.policies.size > 0 -%}
      <ul class="cs-footer__policies" role="list">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <button type="button" class="cs-icon-btn cs-footer__top" data-cs-scroll-top aria-label="Back to top">
      <svg class="cs-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
    </button>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "tag": "div",
  "class": "cs-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "inline_richtext",
      "id": "cta_heading",
      "label": "Heading",
      "info": "Leave empty to hide the banner. Italic words are highlighted.",
      "default": "Ready to launch your brand in <em>India</em>?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text",
      "default": "One partner from first shipment to nationwide scale."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Contact page link",
      "info": "The page with the Custom Contact Us section. Leave empty to use /pages/contact. Each button opens its matching tab automatically."
    },
    {
      "type": "text",
      "id": "retailer_btn_label",
      "label": "Button 1 label (opens Retailer form)",
      "info": "Leave empty to hide this button.",
      "default": "Are you a Retailer?"
    },
    {
      "type": "text",
      "id": "brand_btn_label",
      "label": "Button 2 label (opens Brand form)",
      "info": "Leave empty to hide this button.",
      "default": "Are you a Brand?"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "The brand name is shown as a wordmark when empty."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Wordmark text",
      "default": "PYIE"
    },
    {
      "type": "richtext",
      "id": "about",
      "label": "About text",
      "default": "<p>PYIE is a next-generation technology company dedicated to launching and scaling world-class global tech brands in India.</p>"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Global Brands. Local Expertise. Trusted Experience."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn link"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube link"
    },
    {
      "type": "header",
      "content": "WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "With country code, e.g. +91 98765 43210"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "info": "Fill this to show a large WhatsApp button. Leave empty to show WhatsApp as a small social icon."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Pre-filled WhatsApp message",
      "info": "Optional."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show oversized wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Oversized wordmark text",
      "default": "PYIE"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "info": "Shown after © year and store name.",
      "default": "All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Colour tone",
      "options": [
        { "value": "light", "label": "White" },
        { "value": "paper", "label": "Paper" },
        { "value": "dark", "label": "Midnight" },
        { "value": "custom", "label": "Custom colours" }
      ],
      "default": "dark",
      "info": "Choose \"Custom colours\" to pick your own colours below."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Custom colours – General",
      "info": "Used only when Colour tone is set to \"Custom colours\"."
