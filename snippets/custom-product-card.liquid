{%- if card_product != blank -%}
  {%- liquid
    assign second_image = card_product.media[1].preview_image
    assign on_sale = false
    if card_product.compare_at_price > card_product.price
      assign on_sale = true
    endif
  -%}
  <article class="cs-pcard{% if second_image %} cs-pcard--swap{% endif %}">
    <a href="{{ card_product.url }}" class="cs-pcard__media" tabindex="-1" aria-hidden="true">
      {%- if card_product.featured_media -%}
        {{
          card_product.featured_media.preview_image
          | image_url: width: 900
          | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 70vw', loading: 'lazy', class: 'cs-pcard__img'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'cs-placeholder cs-pcard__img' }}
      {%- endif -%}

      {%- if second_image -%}
        {{
          second_image
          | image_url: width: 900
          | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 70vw', loading: 'lazy', class: 'cs-pcard__img cs-pcard__img--hover', alt: ''
        }}
      {%- endif -%}

      {%- if card_product.available == false -%}
        <span class="cs-pcard__badge cs-pcard__badge--muted">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif on_sale -%}
        <span class="cs-pcard__badge">{{ 'products.product.on_sale' | t }}</span>
      {%- endif -%}
    </a>

    <div class="cs-pcard__body">
      {%- if show_vendor and card_product.vendor != blank -%}
        <span class="cs-pcard__vendor">{{ card_product.vendor | escape }}</span>
      {%- endif -%}

      <h3 class="cs-pcard__title">
        <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
      </h3>

      <div class="cs-pcard__foot">
        <span class="cs-pcard__price">
          {%- if card_product.price_varies -%}
            {%- assign min_price = card_product.price_min | money -%}
            {{- 'products.product.price.from_price_html' | t: price: min_price -}}
          {%- else -%}
            {{- card_product.price | money -}}
          {%- endif -%}
          {%- if on_sale -%}
            <s class="cs-pcard__compare">{{ card_product.compare_at_price | money }}</s>
          {%- endif -%}
        </span>
        <a href="{{ card_product.url }}" class="cs-pcard__go" aria-label="{{ card_product.title | escape }}">
          {% render 'custom-icon', icon: 'arrow-up-right' %}
        </a>
      </div>
    </div>
  </article>
{%- else -%}
  {%- assign placeholder_index = index | default: 1 | modulo: 6 | plus: 1 -%}
  {%- assign placeholder_name = 'product-' | append: placeholder_index -%}
  <article class="cs-pcard">
    <div class="cs-pcard__media">
      {{ placeholder_name | placeholder_svg_tag: 'cs-placeholder cs-pcard__img' }}
    </div>
    <div class="cs-pcard__body">
      {%- if show_vendor -%}<span class="cs-pcard__vendor">Brand</span>{%- endif -%}
      <h3 class="cs-pcard__title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="cs-pcard__foot">
        <span class="cs-pcard__price">{{ 199900 | money }}</span>
        <span class="cs-pcard__go" aria-hidden="true">{% render 'custom-icon', icon: 'arrow-up-right' %}</span>
      </div>
    </div>
  </article>
{%- endif -%}
