        "reason_8trbpP": {
          "type": "reason",
          "settings": {
            "title": "A rapidly affluent middle class",
            "text": "<p><strong>31%</strong> of India's population today, rising to <strong>38% by 2031</strong> — with consumer spending set to grow from <strong>$1.9 trillion to $5.2 trillion</strong> over the same period.</p>"
          }
        },
        "reason_CJMGxt": {
          "type": "reason",
          "settings": {
            "title": "E-commerce inflection point",
            "text": "<p>India's GDP per capita is set to cross the <strong>$4,000 mark by 2030</strong> — the level at which discretionary and online spending has historically accelerated sharply in other markets. Online retail GMV is already growing <strong>20%+ annually</strong>, from $65–66B in 2025 to a projected <strong>$170–180B by 2030</strong>.</p>"
          }
        },
        "reason_q6p3ie": {
          "type": "reason",
          "settings": {
            "title": "Deep headroom in durables",
            "text": "<p>Only <strong>10–15% of Indian households</strong> own an air conditioner and <strong>20–22%</strong> own a washing machine, against near-total penetration in China and Malaysia — meaning category growth is still largely ahead, not behind.</p>"
          }
        },
        "reason_3kf8MG": {
          "type": "reason",
          "settings": {
            "title": "A manufacturing tailwind",
            "text": "<p>India's electronics production has grown <strong>7x in a decade</strong> to <strong>₹13.11 lakh crore in FY26</strong>, with exports up 11x — electronics is now India's third-largest export category.</p>"
          }
        }
      },
