{{ 'customs-stats-points.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign stats = section.blocks | where: 'type', 'stat'
  assign points = section.blocks | where: 'type', 'point'
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
  assign is_custom = false
  if section.settings.tone == 'custom'
    assign is_custom = true
  endif
-%}

{%- style -%}
  /* ---------- Image to the right of the stats (only when an image is set) ---------- */
  #cs-stats-points-{{ section.id }} .cs-sp__top--media-right {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  #cs-stats-points-{{ section.id }} .cs-sp__top--media-right .cs-sp__stats {
    margin-top: 0;
    margin-bottom: 0;
  }
  #cs-stats-points-{{ section.id }} .cs-sp__media--right {
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
  }
  #cs-stats-points-{{ section.id }} .cs-sp__media--right img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media screen and (min-width: 990px) {
    #cs-stats-points-{{ section.id }} .cs-sp__top--media-right {
      grid-template-columns: minmax(0, 1fr) minmax(0, {{ section.settings.image_width | divided_by: 100.0 }}fr);
      gap: 16px;
      margin-bottom: 0;
    }
    /* Stats sit in a narrower column, so use 2 columns there */
    #cs-stats-points-{{ section.id }} .cs-sp__top--media-right .cs-sp__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 989px) {
    #cs-stats-points-{{ section.id }} .cs-sp__top--media-right { margin-bottom: 40px; }
  }

  {%- if is_custom -%}
  /* ---------- Custom colour combination ---------- */
  #cs-stats-points-{{ section.id }}.cs-tone--custom {
    --cs-sp-bg: {{ section.settings.c_bg }};
    --cs-sp-heading: {{ section.settings.c_heading }};
    --cs-sp-text: {{ section.settings.c_text }};
    --cs-sp-accent: {{ section.settings.c_accent }};
    --cs-sp-card-bg: {{ section.settings.c_card_bg }};
    --cs-sp-card-text: {{ section.settings.c_card_text }};
    --cs-sp-border: {{ section.settings.c_border }};
    --cs-sp-featured-bg: {{ section.settings.c_featured_bg }};
    --cs-sp-featured-text: {{ section.settings.c_featured_text }};
    background-color: var(--cs-sp-bg);
    color: var(--cs-sp-text);
  }
  #cs-stats-points-{{ section.id }}.cs-tone--custom h1,
  #cs-stats-points-{{ section.id }}.cs-tone--custom h2,
  #cs-stats-points-{{ section.id }}.cs-tone--custom h3,
  #cs-stats-points-{{ section.id }}.cs-tone--custom [class*="heading"],
  #cs-stats-points-{{ section.id }}.cs-tone--custom [class*="title"] {
    color: var(--cs-sp-heading);
  }
  #cs-stats-points-{{ section.id }}.cs-tone--custom em,
  #cs-stats-points-{{ section.id }}.cs-tone--custom [class*="eyebrow"] {
    color: var(--cs-sp-accent);
  }
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-text,
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-text p,
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-footnote {
    color: var(--cs-sp-text);
  }
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__stat {
    background-color: var(--cs-sp-card-bg);
    color: var(--cs-sp-card-text);
    border-color: var(--cs-sp-border);
  }
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__stat-value { color: var(--cs-sp-accent); }
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__stat-label { color: var(--cs-sp-card-text); }
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__stat-icon,
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__point-icon {
    color: var(--cs-sp-accent);
  }
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__stat--featured {
    background-color: var(--cs-sp-featured-bg);
    color: var(--cs-sp-featured-text);
  }
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__stat--featured .cs-sp__stat-value,
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__stat--featured .cs-sp__stat-label,
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__stat--featured .cs-sp__stat-icon {
    color: var(--cs-sp-featured-text);
  }
  #cs-stats-points-{{ section.id }}.cs-tone--custom .cs-sp__point {
    border-color: var(--cs-sp-border);
  }
  {%- endif -%}
{%- endstyle -%}

<section
  id="cs-stats-points-{{ section.id }}"
  class="cs-section cs-sp cs-tone--{{ section.settings.tone }}"
  style="--cs-pt: {{ section.settings.padding_top }}px; --cs-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="cs-container">
    {%- render 'custom-section-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      align: 'split'
    -%}

    {%- if stats.size > 0 or has_image -%}
      {%- if has_image -%}<div class="cs-sp__top cs-sp__top--media-right">{%- endif -%}

      {%- if stats.size > 0 -%}
        <ul class="cs-sp__stats">
          {%- for block in stats -%}
            <li
              class="cs-sp__stat{% if block.settings.featured %} cs-sp__stat--featured{% endif %}"
              data-cs-reveal
              style="--cs-delay: {{ forloop.index0 | times: 60 }}ms;"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != 'none' -%}
                <span class="cs-sp__stat-icon">{% render 'custom-icon', icon: block.settings.icon %}</span>
              {%- endif -%}
              <span class="cs-sp__stat-value" data-cs-count>{{ block.settings.value }}</span>
              <span class="cs-sp__stat-label">{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if has_image -%}
          <div class="cs-media cs-sp__media cs-sp__media--right" data-cs-reveal>
            {% render 'cs-image', image: section.settings.image, sizes: '(min-width: 990px) 45vw, 100vw' %}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if points.size > 0 -%}
      <div class="cs-sp__body">
        <ul class="cs-sp__points">
          {%- for block in points -%}
            <li class="cs-sp__point" data-cs-reveal style="--cs-delay: {{ forloop.index0 | times: 80 }}ms;" {{ block.shopify_attributes }}>
              <span class="cs-sp__point-icon" aria-hidden="true">{% render 'custom-icon', icon: 'arrow-up-right' %}</span>
              <div class="cs-text">{{ block.settings.text }}</div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="cs-footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Stats with points",
  "tag": "div",
  "class": "cs-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Distribution"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "India's deepest <em>offline distribution</em> network*"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Right image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (shows on the right of stats)",
      "info": "Optional - e.g. a coverage map. Shows to the right of the stats grid. Leave empty to hide."
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width (relative to stats)",
      "min": 50,
      "max": 150,
      "step": 10,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Colour tone",
      "options": [
        { "value": "light", "label": "White" },
        { "value": "paper", "label": "Paper" },
        { "value": "dark", "label": "Midnight" },
        { "value": "accent", "label": "Saffron" },
        { "value": "graphite", "label": "Graphite" },
        { "value": "custom", "label": "Custom colours" }
      ],
      "default": "dark",
      "info": "Choose \"Custom colours\" to pick your own colours below."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Custom colours",
      "info": "Used only when Colour tone is set to \"Custom colours\"."
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Section background",
      "default": "#0F172A",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_heading",
      "label": "Heading",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Body text",
      "default": "#CBD5E1",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_accent",
      "label": "Accent (eyebrow, highlight, numbers, icons)",
      "default": "#F59E0B",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_card_bg",
      "label": "Stat card background",
      "default": "#1E293B",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_card_text",
      "label": "Stat card label",
      "default": "#E2E8F0",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_featured_bg",
      "label": "Featured stat background",
      "default": "#F59E0B",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_featured_text",
      "label": "Featured stat text",
      "default": "#0F172A",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    {
      "type": "color",
      "id": "c_border",
      "label": "Borders / dividers",
      "default": "#334155",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "Counts up on scroll. Indian grouping works, e.g. 1,50,000+",
          "default": "25,000+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Distributors"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "users", "label": "Users" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "store", "label": "Store" },
            { "value": "box", "label": "Box" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "globe", "label": "Globe" },
            { "value": "headset", "label": "Headset" },
            { "value": "truck", "label": "Truck" },
            { "value": "factory", "label": "Factory" }
          ],
          "default": "none"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Feature this stat",
          "info": "Takes two columns on desktop.",
          "default": false
        }
      ]
    },
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add a supporting point here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Stats with points",
      "blocks": [
        { "type": "stat", "settings": { "featured": true } },
        { "type": "stat", "settings": { "value": "18,000+", "label": "PIN codes covered" } },
        { "type": "stat", "settings": { "value": "37+", "label": "Warehouses" } },
        { "type": "point" },
        { "type": "point" }
      ]
    }
  ]
}
{% endschema %}
