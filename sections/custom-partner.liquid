{{ 'custom-partners.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000
  assign partners = section.blocks | where: 'type', 'partner'
  assign max_products = 6
  assign section_key = 'cs-partners-' | append: section.id
-%}

{%- if section.settings.tone == 'custom' -%}
  {%- style -%}
    /* ---------- Custom colour combination ---------- */
    #{{ section_key }}.cs-tone--custom {
      --cs-p-bg: {{ section.settings.c_bg }};
      --cs-p-heading: {{ section.settings.c_heading }};
      --cs-p-text: {{ section.settings.c_text }};
      --cs-p-accent: {{ section.settings.c_accent }};
      --cs-p-border: {{ section.settings.c_border }};
      background-color: var(--cs-p-bg);
      color: var(--cs-p-text);
    }

    /* Head */
    #{{ section_key }}.cs-tone--custom > .cs-container:first-child h1,
    #{{ section_key }}.cs-tone--custom > .cs-container:first-child h2,
    #{{ section_key }}.cs-tone--custom > .cs-container:first-child [class*="heading"] {
      color: var(--cs-p-heading);
    }
    #{{ section_key }}.cs-tone--custom > .cs-container:first-child em,
    #{{ section_key }}.cs-tone--custom [class*="eyebrow"] {
      color: var(--cs-p-accent);
    }
    #{{ section_key }}.cs-tone--custom > .cs-container:first-child .cs-text,
    #{{ section_key }}.cs-tone--custom > .cs-container:first-child p {
      color: var(--cs-p-text);
    }

    /* Partner cards */
    #{{ section_key }}.cs-tone--custom .cs-partners__card {
      background-color: {{ section.settings.c_card_bg }};
      border-color: var(--cs-p-border);
    }
    #{{ section_key }}.cs-tone--custom .cs-partners__wordmark { color: {{ section.settings.c_wordmark }}; }
    #{{ section_key }}.cs-tone--custom .cs-partners__desc { color: {{ section.settings.c_card_text }}; }
    #{{ section_key }}.cs-tone--custom .cs-partners__tag {
      background-color: {{ section.settings.c_tag_bg }};
      color: {{ section.settings.c_tag_text }};
      border-color: {{ section.settings.c_tag_bg }};
    }
    #{{ section_key }}.cs-tone--custom .cs-partners__cta,
    #{{ section_key }}.cs-tone--custom .cs-partners__cta svg {
      color: {{ section.settings.c_cta }};
      stroke: currentColor;
    }
    #{{ section_key }}.cs-tone--custom .cs-partners__card.has-shop:hover,
    #{{ section_key }}.cs-tone--custom .cs-partners__card.is-active {
      background-color: {{ section.settings.c_card_active_bg }};
      border-color: {{ section.settings.c_card_active_border }};
    }

    /* Slider nav + progress */
    #{{ section_key }}.cs-tone--custom .cs-icon-btn {
      background-color: {{ section.settings.c_btn_bg }};
      color: {{ section.settings.c_btn_icon }};
      border-color: {{ section.settings.c_btn_border }};
    }
    #{{ section_key }}.cs-tone--custom .cs-icon-btn svg { color: inherit; stroke: currentColor; }
    #{{ section_key }}.cs-tone--custom .cs-icon-btn:hover,
    #{{ section_key }}.cs-tone--custom .cs-icon-btn:focus-visible {
      background-color: {{ section.settings.c_btn_hover_bg }};
      color: {{ section.settings.c_btn_hover_icon }};
      border-color: {{ section.settings.c_btn_hover_bg }};
    }
    #{{ section_key }}.cs-tone--custom .cs-progress { background-color: {{ section.settings.c_progress_track }}; }
    #{{ section_key }}.cs-tone--custom .cs-progress__bar { background-color: {{ section.settings.c_progress_bar }}; }

    /* Products panel */
    #{{ section_key }}.cs-tone--custom .cs-partners__shop {
      background-color: {{ section.settings.c_shop_bg }};
      border-color: var(--cs-p-border);
    }
    #{{ section_key }}.cs-tone--custom .cs-partners__shop-eyebrow { color: var(--cs-p-accent); }
    #{{ section_key }}.cs-tone--custom .cs-partners__shop-title { color: {{ section.settings.c_shop_title }}; }
    #{{ section_key }}.cs-tone--custom .cs-partners__store-link,
    #{{ section_key }}.cs-tone--custom .cs-partners__store-link svg {
      color: {{ section.settings.c_store_link }};
      stroke: currentColor;
    }
    #{{ section_key }}.cs-tone--custom .cs-partners__shop-close {
      background-color: transparent;
      color: {{ section.settings.c_shop_title }};
      border-color: var(--cs-p-border);
    }
    #{{ section_key }}.cs-tone--custom .cs-partners__shop-close svg { color: inherit; stroke: currentColor; }

    /* Product cards */
    #{{ section_key }}.cs-tone--custom .cs-partners__product {
      background-color: {{ section.settings.c_product_bg }};
      border-color: var(--cs-p-border);
    }
    #{{ section_key }}.cs-tone--custom .cs-partners__product-title { color: {{ section.settings.c_product_title }}; }
    #{{ section_key }}.cs-tone--custom .cs-partners__price,
    #{{ section_key }}.cs-tone--custom .cs-partners__price-now { color: {{ section.settings.c_price }}; }
    #{{ section_key }}.cs-tone--custom .cs-partners__buy {
      background-color: {{ section.settings.c_buy_bg }};
      color: {{ section.settings.c_buy_text }};
      border-color: {{ section.settings.c_buy_bg }};
    }
    #{{ section_key }}.cs-tone--custom .cs-partners__buy svg { color: inherit; stroke: currentColor; }
    #{{ section_key }}.cs-tone--custom .cs-partners__buy:hover,
    #{{ section_key }}.cs-tone--custom .cs-partners__buy:focus-visible {
      background-color: {{ section.settings.c_buy_hover_bg }};
      color: {{ section.settings.c_buy_hover_text }};
      border-color: {{ section.settings.c_buy_hover_bg }};
    }

    /* Footnote */
    #{{ section_key }}.cs-tone--custom .cs-footnote { color: {{ section.settings.c_footnote }}; }
  {%- endstyle -%}
{%- endif -%}

<section
  id="{{ section_key }}"
  class="cs-section cs-partners cs-tone--{{ section.settings.tone }} cs-partners--logo-{{ section.settings.logo_style }}"
  style="--cs-pt: {{ section.settings.padding_top }}px; --cs-pb: {{ section.settings.padding_bottom }}px;"
  data-cs-slider-wrap
>
  <div class="cs-container">
    {%- render 'custom-section-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      align: 'center'
    -%}
  </div>

  {%- if partners.size > 0 -%}
    <div
      class="cs-partners__slider cs-slider"
      data-cs-slider='{"wrapAround": true, "cellAlign": "center", "contain": false, "autoPlay": {% if section.settings.autoplay %}{{ autoplay_ms }}{% else %}false{% endif %}}'
      tabindex="0"
      aria-label="{{ section.settings.heading | strip_html | escape }}"
    >
      {%- for block in partners -%}
        {%- liquid
          assign panel_id = section_key | append: '-shop-' | append: block.id
          assign item_count = 0
          for n in (1..max_products)
            assign key_title = 'product_' | append: n | append: '_title'
            assign key_image = 'product_' | append: n | append: '_image'
            if block.settings[key_title] != blank or block.settings[key_image] != blank
              assign item_count = item_count | plus: 1
            endif
          endfor
        -%}
        <article
          class="cs-partners__card cs-cell{% if item_count > 0 %} has-shop{% endif %}"
          data-cs-index="{{ forloop.index0 }}"
          {% if item_count > 0 %}
            data-cs-shop-target="{{ panel_id }}"
            role="button"
            tabindex="0"
            aria-expanded="false"
            aria-controls="{{ panel_id }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="cs-partners__logo">
            {%- if block.settings.logo != blank -%}
              {{
                block.settings.logo
                | image_url: width: 480
                | image_tag: loading: 'lazy', class: 'cs-partners__logo-img', alt: block.settings.name, sizes: '240px', widths: '240, 480'
              }}
            {%- else -%}
              <span class="cs-partners__wordmark">{{ block.settings.name | escape }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.description != blank -%}
            <p class="cs-partners__desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}

          {%- if block.settings.tag != blank -%}
            <span class="cs-partners__tag">{{ block.settings.tag | escape }}</span>
          {%- endif -%}

          {%- if item_count > 0 -%}
            <span class="cs-partners__cta">
              {{- section.settings.cta_label | escape -}}
              <svg class="cs-partners__cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    <div class="cs-container cs-partners__foot">
      <div class="cs-slider-nav">
        <button type="button" class="cs-icon-btn" data-cs-prev aria-label="Previous partner">
          {% render 'custom-icon', icon: 'arrow-left' %}
        </button>
        <div class="cs-progress" aria-hidden="true"><span class="cs-progress__bar" data-cs-progress></span></div>
        <button type="button" class="cs-icon-btn" data-cs-next aria-label="Next partner">
          {% render 'custom-icon', icon: 'arrow-right' %}
        </button>
      </div>

      <div class="cs-partners__shops">
        {%- for block in partners -%}
          {%- liquid
            assign panel_id = section_key | append: '-shop-' | append: block.id
            assign item_count = 0
            for n in (1..max_products)
              assign key_title = 'product_' | append: n | append: '_title'
              assign key_image = 'product_' | append: n | append: '_image'
              if block.settings[key_title] != blank or block.settings[key_image] != blank
                assign item_count = item_count | plus: 1
              endif
            endfor
          -%}
          {%- if item_count > 0 -%}
            <div class="cs-partners__shop" id="{{ panel_id }}" data-cs-shop-panel role="region" aria-label="{{ block.settings.name | escape }} products" hidden>
              <div class="cs-partners__shop-head">
                <div>
                  {%- if section.settings.shop_eyebrow != blank -%}
                    <p class="cs-partners__shop-eyebrow">{{ section.settings.shop_eyebrow | escape }}</p>
                  {%- endif -%}
                  <h3 class="cs-partners__shop-title">{{ block.settings.name | escape }} {{ section.settings.shop_title_suffix | escape }}</h3>
                </div>

                <div class="cs-partners__shop-actions">
                  {%- if block.settings.amazon_store_url != blank -%}
                    <a class="cs-partners__store-link" href="{{ block.settings.amazon_store_url }}" target="_blank" rel="noopener nofollow">
                      {{- section.settings.store_label | escape -}}
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8"></path></svg>
                    </a>
                  {%- endif -%}
                  <button type="button" class="cs-partners__shop-close" data-cs-shop-close aria-label="Close {{ block.settings.name | escape }} products">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                  </button>
                </div>
              </div>

              <ul class="cs-partners__products" role="list">
                {%- for n in (1..max_products) -%}
                  {%- liquid
                    assign key_title = 'product_' | append: n | append: '_title'
                    assign key_image = 'product_' | append: n | append: '_image'
                    assign key_url = 'product_' | append: n | append: '_url'
                    assign key_price = 'product_' | append: n | append: '_price'
                    assign p_title = block.settings[key_title]
                    assign p_image = block.settings[key_image]
                    assign p_url = block.settings[key_url]
                    assign p_price = block.settings[key_price]
                  -%}
                  {%- if p_title != blank or p_image != blank -%}
                    <li class="cs-partners__product">
                      <a
                        class="cs-partners__product-media"
                        {% if p_url != blank %}href="{{ p_url }}" target="_blank" rel="noopener nofollow"{% endif %}
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        {%- if p_image != blank -%}
                          {{
                            p_image
                            | image_url: width: 600
                            | image_tag: loading: 'lazy', class: 'cs-partners__product-img', alt: p_title, sizes: '(min-width: 990px) 20vw, 45vw', widths: '300, 450, 600'
                          }}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'cs-partners__product-img cs-partners__product-img--placeholder' }}
                        {%- endif -%}
                      </a>

                      <div class="cs-partners__product-body">
                        {%- if p_title != blank -%}
                          <h4 class="cs-partners__product-title">{{ p_title | escape }}</h4>
                        {%- endif -%}

                        {%- if p_price != blank -%}
                          <p class="cs-partners__price">
                            <span class="cs-partners__price-now">{{ p_price | escape }}</span>
                          </p>
                        {%- endif -%}

                        {%- if p_url != blank -%}
                          <a class="cs-partners__buy" href="{{ p_url }}" target="_blank" rel="noopener nofollow">
                            {{- section.settings.buy_label | escape -}}
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8"></path></svg>
                            <span class="visually-hidden"> {{ p_title | escape }} (opens Amazon in a new tab)</span>
                          </a>
                        {%- endif -%}
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="cs-footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('{{ section_key }}');
    if (!root || root.getAttribute('data-cs-shop-ready')) return;
    root.setAttribute('data-cs-shop-ready', '1');

    var slider = root.querySelector('.cs-partners__slider');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function getFlickity() {
      return window.Flickity && slider ? window.Flickity.data(slider) : null;
    }

    function cardFor(panelId) {
      var cards = root.querySelectorAll('[data-cs-shop-target]');
      for (var i = 0; i < cards.length; i++) {
        if (cards[i].getAttribute('data-cs-shop-target') === panelId) return cards[i];
      }
      return null;
    }

    function open(panelId, scroll) {
      var target = panelId ? document.getElementById(panelId) : null;

      root.querySelectorAll('[data-cs-shop-panel]').forEach(function (panel) {
        if (panel === target) return;
        panel.classList.remove('is-open');
        panel.hidden = true;
      });

      root.querySelectorAll('[data-cs-shop-target]').forEach(function (card) {
        var active = !!target && card.getAttribute('data-cs-shop-target') === panelId;
        card.classList.toggle('is-active', active);
        card.setAttribute('aria-expanded', active ? 'true' : 'false');
      });

      root.classList.toggle('has-shop-open', !!target);
      if (!target) return;

      target.hidden = false;
      requestAnimationFrame(function () {
        target.classList.add('is-open');
      });

      // Stop the logo slider on the chosen partner so the panel and the card stay in sync.
      var flkty = getFlickity();
      var card = cardFor(panelId);
      if (flkty) {
        if (typeof flkty.stopPlayer === 'function') flkty.stopPlayer();
        var index = card ? Number(card.getAttribute('data-cs-index')) : -1;
        if (index >= 0 && flkty.selectedIndex !== index) flkty.select(index);
      }

      if (scroll) {
        var rect = target.getBoundingClientRect();
        if (rect.top > window.innerHeight * 0.75 || rect.top < 0) {
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
        }
      }
    }

    function toggle(card) {
      var panelId = card.getAttribute('data-cs-shop-target');
      open(card.classList.contains('is-active') ? null : panelId, true);
    }

    root.addEventListener('click', function (event) {
      var closeBtn = event.target.closest('[data-cs-shop-close]');
      if (closeBtn) {
        var panel = closeBtn.closest('[data-cs-shop-panel]');
        var card = panel ? cardFor(panel.id) : null;
        open(null);
        if (card) card.focus({ preventScroll: true });
        return;
      }

      var target = event.target.closest('[data-cs-shop-target]');
      if (target && root.contains(target)) toggle(target);
    });

    root.addEventListener('keydown', function (event) {
      var card = event.target.closest('[data-cs-shop-target]');
      if (card && (event.key === 'Enter' || event.key === ' ')) {
        event.preventDefault();
        toggle(card);
        return;
      }

      if (event.key === 'Escape' && event.target.closest('[data-cs-shop-panel]')) {
        var panel = event.target.closest('[data-cs-shop-panel]');
        var owner = cardFor(panel.id);
        open(null);
        if (owner) owner.focus({ preventScroll: true });
      }
    });

    // Theme editor: selecting a partner block opens its products panel.
    root.addEventListener('shopify:block:select', function (event) {
      var card = event.target.closest && event.target.closest('[data-cs-shop-target]');
      if (card) open(card.getAttribute('data-cs-shop-target'), true);
    });
  })();
</script>

{% schema %}
{
  "name": "Custom Partner logos",
  "tag": "div",
  "class": "cs-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Brand partners"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<em>Trusted</em> by global category leaders"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>A growing roster of global electronics leaders choosing one India GTM partner for exclusive, long-term market entry.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "10-year exclusive distribution contracts unless noted"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-play",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-play speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "header",
      "content": "Amazon products",
      "info": "Add up to 6 products inside each Partner block. Clicking a partner shows its products below the slider."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Partner card link text",
      "default": "View products"
    },
    {
      "type": "text",
      "id": "shop_eyebrow",
      "label": "Products eyebrow",
      "default": "Available on Amazon"
    },
    {
      "type": "text",
      "id": "shop_title_suffix",
      "label": "Products heading after brand name",
      "default": "products"
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Buy button label",
      "default": "Buy on Amazon"
    },
    {
      "type": "text",
      "id": "store_label",
      "label": "Brand store link label",
      "default": "View all on Amazon"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Colour tone",
      "options": [
        { "value": "light", "label": "White" },
        { "value": "paper", "label": "Paper" },
        { "value": "dark", "label": "Midnight" },
        { "value": "accent", "label": "Saffron" },
        { "value": "graphite", "label": "Graphite" },
        { "value": "custom", "label": "Custom colours" }
      ],
      "default": "paper",
      "info": "Choose \"Custom colours\" to pick your own colours below."
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo colour",
      "info": "White turns every logo white, useful on Midnight, Graphite or a dark custom background.",
      "options": [
        { "value": "original", "label": "Original" },
        { "value": "white", "label": "White" }
      ],
      "default": "original"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Custom colours – Section",
      "info": "Used only when Colour tone is set to \"Custom colours\"."
    },
    { "type": "color", "id": "c_bg", "label": "Section background", "default": "#F8F5EF", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_heading", "label": "Heading", "default": "#0F172A", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_text", "label": "Intro text", "default": "#475569", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_accent", "label": "Accent (eyebrows, italic words)", "default": "#F59E0B", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_border", "label": "Borders / dividers", "default": "#E2E8F0", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_footnote", "label": "Footnote", "default": "#64748B", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    {
      "type": "header",
      "content": "Custom colours – Partner cards",
      "visible_if": "{{ section.settings.tone == 'custom' }}"
    },
    { "type": "color", "id": "c_card_bg", "label": "Card background", "default": "#FFFFFF", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_wordmark", "label": "Brand name (when no logo)", "default": "#0F172A", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_card_text", "label": "Description", "default": "#64748B", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_tag_bg", "label": "Tag background", "default": "#FEF3C7", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_tag_text", "label": "Tag text", "default": "#B45309", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_cta", "label": "\"View products\" link", "default": "#0F172A", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_card_active_bg", "label": "Active / hover card background", "default": "#FFFFFF", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    { "type": "color", "id": "c_card_active_border", "label": "Active / hover card border", "default": "#F59E0B", "visible_if": "{{ section.settings.tone == 'custom' }}" },
    {
      "type": "header",
      "content": "Custom colours – Slider controls",
