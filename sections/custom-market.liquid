{{ 'custom-market.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign metrics = section.blocks | where: 'type', 'metric'
  assign reasons = section.blocks | where: 'type', 'reason'

  assign start_year = section.settings.start_year | default: 2025
  assign end_year = section.settings.end_year | default: 2033
  assign start_value = section.settings.start_value | default: 101 | times: 1.0
  assign growth = section.settings.cagr | default: 7.8 | divided_by: 100.0 | plus: 1
  assign span = end_year | minus: start_year

  comment
    Compound the start value once to find the final bar, so every bar can be scaled against it.
  endcomment
  assign final_value = start_value
  for i in (1..span)
    assign final_value = final_value | times: growth
  endfor

  # a published end figure wins over the compounded one, so the last bar matches the source
  if section.settings.end_value != blank
    assign final_value = section.settings.end_value | times: 1.0
  endif
-%}

{%- if section.settings.tone == 'custom' -%}
  {%- style -%}
    /* ---------- Custom colour combination ---------- */
    #cs-market-{{ section.id }}.cs-tone--custom {
      --cs-m-bg: {{ section.settings.c_bg }};
      --cs-m-heading: {{ section.settings.c_heading }};
      --cs-m-text: {{ section.settings.c_text }};
      --cs-m-accent: {{ section.settings.c_accent }};
      --cs-m-big: {{ section.settings.c_big }};
      --cs-m-card-bg: {{ section.settings.c_card_bg }};
      --cs-m-card-text: {{ section.settings.c_card_text }};
      --cs-m-border: {{ section.settings.c_border }};
      --cs-m-bar: {{ section.settings.c_bar }};
      --cs-m-bar-actual: {{ section.settings.c_bar_actual }};
      --cs-m-tag-bg: {{ section.settings.c_tag_bg }};
      --cs-m-tag-text: {{ section.settings.c_tag_text }};
      --cs-m-metric: {{ section.settings.c_metric }};
      --cs-m-why-bg: {{ section.settings.c_why_bg }};
      --cs-m-why-text: {{ section.settings.c_why_text }};
      --cs-m-num: {{ section.settings.c_num }};
      --cs-m-closing: {{ section.settings.c_closing }};
      --cs-m-closing-strong: {{ section.settings.c_closing_strong }};
      background-color: var(--cs-m-bg);
      color: var(--cs-m-text);
    }

    /* Head */
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__top h1,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__top h2,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__top h3,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__top [class*="heading"],
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__top [class*="title"] {
      color: var(--cs-m-heading);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__top em,
    #cs-market-{{ section.id }}.cs-tone--custom [class*="eyebrow"] {
      color: var(--cs-m-accent);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__top .cs-text,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__top p {
      color: var(--cs-m-text);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__big-value { color: var(--cs-m-big); }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__big-label { color: var(--cs-m-text); }

    /* Chart + metrics panel */
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__chart,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__metric {
      background-color: var(--cs-m-card-bg);
      color: var(--cs-m-card-text);
      border-color: var(--cs-m-border);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__chart-title,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__chart-note,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__bar-year,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__metric-label {
      color: var(--cs-m-card-text);
    }

#cs-market-{{ section.id }}.cs-tone--custom .cs-market__bar-value {
  color: var(--cs-m-bar-actual);
}

    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__chart-tag {
      background-color: var(--cs-m-tag-bg);
      color: var(--cs-m-tag-text);
      border-color: var(--cs-m-tag-bg);
    }
 
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__bar.is-actual .cs-market__bar-fill {
      background: var(--cs-m-bar-actual);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__bars,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__chart-head {
      border-color: var(--cs-m-border);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__metric-value { color: var(--cs-m-metric); }

    /* Why now */
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__why {
      background-color: var(--cs-m-why-bg);
      color: var(--cs-m-why-text);
      border-color: var(--cs-m-border);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__why-title,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__reason-title,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__reason-body,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__reason-body p {
      color: var(--cs-m-why-text);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__reason {
      border-color: var(--cs-m-border);
    }
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__reason-num,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__reason-toggle,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__reason-toggle svg {
      color: var(--cs-m-num);
    }

    /* Closing */
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__closing,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__closing p {
      color: #fff;
      border-color: var(--cs-m-accent);
    background: linear-gradient(90deg, #00abe429, #ffffff08 60%, #ffffff05);
    }

#cs-market-{{ section.id }}.cs-tone--custom .cs-market__closing p {
      border: 0;
    background: transparent;
}

    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__closing strong,
    #cs-market-{{ section.id }}.cs-tone--custom .cs-market__closing em {
      color: var(--cs-m-closing-strong);
    }
  {%- endstyle -%}
{%- endif -%}

<section
  id="cs-market-{{ section.id }}"
  class="cs-section cs-market cs-tone--{{ section.settings.tone }}"
  style="--cs-pt: {{ section.settings.padding_top }}px; --cs-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="cs-container">
    <div class="cs-market__top">
      {%- render 'custom-section-head',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.text
      -%}

      {%- if section.settings.big_value != blank -%}
        <div class="cs-market__big" data-cs-reveal>
          <span class="cs-market__big-value" data-cs-count>{{ section.settings.big_value }}</span>
          <span class="cs-market__big-label">{{ section.settings.big_label }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="cs-market__grid">
      <div class="cs-market__panel">
        {%- if span > 0 -%}
          <figure class="cs-market__chart" data-cs-reveal>
            <figcaption class="cs-market__chart-head">
              <span class="cs-market__chart-title">{{ section.settings.chart_title }}</span>
              <span class="cs-market__chart-tag">{{ section.settings.cagr }}% CAGR</span>
            </figcaption>

            <div class="cs-market__bars" role="img" aria-label="{{ section.settings.chart_title | escape }}: {{ section.settings.unit_prefix }}{{ start_value | round }}{{ section.settings.unit_suffix }} in {{ start_year }} to {{ section.settings.unit_prefix }}{{ final_value | round }}{{ section.settings.unit_suffix }} in {{ end_year }}">
              {%- assign value = start_value -%}
              {%- for i in (0..span) -%}
                {%- liquid
                  if i > 0
                    assign value = value | times: growth
                  endif
                  if forloop.last
                    assign value = final_value
                  endif
                  assign pct = value | divided_by: final_value | times: 100 | round: 1
                  assign year = start_year | plus: i
                -%}
                <div
                  class="cs-market__bar{% if forloop.first %} is-actual{% endif %}{% if forloop.first or forloop.last %} is-labelled{% endif %}"
                  style="--cs-h: {{ pct }}%; --cs-delay: {{ i | times: 60 }}ms;"
                >
                  <span class="cs-market__bar-value">{{ section.settings.unit_prefix }}{{ value | round }}{{ section.settings.unit_suffix }}</span>
                  <span class="cs-market__bar-fill"></span>
                  <span class="cs-market__bar-year">{{ year | append: '' | slice: 2, 2 | prepend: "'" }}</span>
                </div>
              {%- endfor -%}
            </div>

            {%- if section.settings.chart_note != blank -%}
              <p class="cs-market__chart-note">{{ section.settings.chart_note }}</p>
            {%- endif -%}
          </figure>
        {%- endif -%}

        {%- if metrics.size > 0 -%}
          <div class="cs-market__metrics">
            {%- for block in metrics -%}
              <div class="cs-market__metric" data-cs-reveal style="--cs-delay: {{ forloop.index0 | times: 80 }}ms;" {{ block.shopify_attributes }}>
                <span class="cs-market__metric-value" data-cs-count>{{ block.settings.value }}</span>
                <span class="cs-market__metric-label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if reasons.size > 0 -%}
        <div class="cs-market__why" data-cs-reveal style="--cs-delay: 120ms;">
          {%- if section.settings.why_heading != blank -%}
            <h3 class="cs-market__why-title">{{ section.settings.why_heading }}</h3>
          {%- endif -%}

          {%- for block in reasons -%}
            <details class="cs-market__reason" name="cs-why-{{ section.id }}"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
              <summary class="cs-market__reason-head">
                <span class="cs-market__reason-num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <span class="cs-market__reason-title">{{ block.settings.title }}</span>
                <span class="cs-market__reason-toggle" aria-hidden="true">{% render 'custom-icon', icon: 'plus' %}</span>
              </summary>
              <div class="cs-market__reason-body cs-text">{{ block.settings.text }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.closing != blank -%}
      <blockquote class="cs-market__closing" data-cs-reveal>
        <p>{{ section.settings.closing }}</p>
      </blockquote>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
